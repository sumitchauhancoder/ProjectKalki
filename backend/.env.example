# ==============================================================================
# PROJECT KALKI - Environment Configuration Template
# Copy this file to `backend/.env` for local development.
# IMPORTANT: Never commit `backend/.env` or any real API keys/credentials to Git.
# ==============================================================================

# Primary LLM: Google Gemini (Free tier key from Google AI Studio)
# Model names change over time; verify current model identifiers at:
# https://ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=
GEMINI_MODEL=

# Fallback LLM: Groq (Optional fallback key from Groq console: https://console.groq.com)
# Used only if the primary Gemini request fails (quota, timeout, or service error).
# Verify current Groq models at: https://console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODEL=

# Database Configuration:
# - Default: SQLite local database for standalone operation without a server.
# - PostgreSQL (Neon): Set to your Neon connection string.
#   Neon example: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=sqlite:///backend/kalki.db
DB_CONNECT_TIMEOUT=10

# Firebase Authentication (Phase 3+):
# The service account JSON file MUST NEVER be committed to Git. Keep it outside
# the repository directory and reference its absolute local path here.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
